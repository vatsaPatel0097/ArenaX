# ArenaX Backend Environment Variables Example

# Server Configuration
PROJECT_NAME="ArenaX API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arenax
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/arenax"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# LLM Provider API Keys
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""

# Authentication (Clerk)
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
